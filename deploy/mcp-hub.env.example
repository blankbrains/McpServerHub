# Copy to /etc/mcp-hub/mcp-hub.env, replace every placeholder, then set mode 0600.
MCP_HUB_DATABASE_URL=postgresql+asyncpg://mcp_hub:<database-password>@localhost:5432/mcp_hub
MCP_HUB_SECRET=<long-random-jwt-secret>
MCP_HUB_GITHUB_CLIENT_ID=<github-oauth-client-id>
MCP_HUB_GITHUB_CLIENT_SECRET=<github-oauth-client-secret>
MCP_HUB_GITHUB_REDIRECT_URI=https://<public-host>/api/v1/auth/callback
MCP_HUB_LOG_DIR=/var/log/mcp-hub
MCP_HUB_HOST=0.0.0.0
MCP_HUB_PORT=3987
